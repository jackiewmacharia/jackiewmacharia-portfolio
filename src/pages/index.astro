---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from '../lib/variants';
import { getCollection } from 'astro:content';

// const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
//   .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
//   .slice(0, 3);

// const featuredProjects = (await getCollection('projects'))
//   .filter(p => p.data.featured)
//   .slice(0, 3);

const recentPosts: any[] = [];
const featuredProjects: any[] = [];

const showScrollIndicator = recentPosts.length > 0 || featuredProjects.length > 0;
---

<BaseLayout>
  <main class="flex flex-1 flex-col">
    <!-- Hero -->
    <section id="hero" class="mx-auto flex flex-1 max-w-5xl flex-col px-6">
      <div class="flex flex-1 items-center">
        <div class="max-w-2xl">
          <p class="mb-4 text-sm font-mono text-primary">hi there —</p>
          <h1 class="mb-4 text-5xl font-bold tracking-tight text-foreground sm:text-6xl">
            I'm <span class="text-primary">Jackie</span><br />Macharia
          </h1>
          <p class="mb-4 text-xl text-muted-foreground">Software Engineer</p>
          <p class="mb-8 max-w-lg leading-relaxed text-muted-foreground">
            Software Engineer passionate about building great experiences.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/about" class={buttonVariants({ variant: 'primary' })}>about me</a>
            <a
              href="https://github.com/jackiewmacharia"
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({ variant: 'ghost' })}
            >
              github
            </a>
            <a
              href="https://www.linkedin.com/in/jackiewmacharia/"
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({ variant: 'ghost' })}
            >
              linkedin
            </a>
            <a href="/blog" class={buttonVariants({ variant: 'ghost' })}>blog</a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      {showScrollIndicator && (
        <div id="scroll-arrow" class="flex justify-center pb-10 transition-opacity duration-300">
          <a href="#content" aria-label="Scroll to content" class="animate-bounce text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      )}
      </div>
    </section>

    <!-- Recent posts -->
    {recentPosts.length > 0 && (
      <section id="content" class="mx-auto max-w-5xl border-t border-border px-6 py-20">
        <div class="mb-10 flex items-baseline justify-between">
          <h2 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">Recent Writing</h2>
          <a href="/blog" class="text-sm font-mono text-primary transition-colors hover:text-primary-hover">
            all posts &rarr;
          </a>
        </div>
        <div class="flex flex-col divide-y divide-border">
          {recentPosts.map(post => {
            const date = post.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            return (
              <a href={`/blog/${post.slug}`} class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="font-medium text-foreground transition-colors group-hover:text-primary">
                  {post.data.title}
                </span>
                <span class="shrink-0 text-xs font-mono text-muted-foreground">{date}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Featured projects -->
    {featuredProjects.length > 0 && (
      <section class="mx-auto max-w-5xl border-t border-border px-6 py-20">
        <div class="mb-10 flex items-baseline justify-between">
          <h2 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">Featured Projects</h2>
          <a href="/projects" class="text-sm font-mono text-primary transition-colors hover:text-primary-hover">
            all projects &rarr;
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map(project => (
            <div class="rounded-lg border border-border bg-surface p-5 transition-colors hover:border-primary/40">
              <h3 class="mb-2 font-semibold text-foreground">{project.data.title}</h3>
              <p class="mb-4 text-sm text-muted-foreground">{project.data.description}</p>
              <div class="flex gap-3 text-xs font-mono">
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground transition-colors hover:text-primary"
                >
                  GitHub &rarr;
                </a>
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    Live &rarr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  const arrow = document.getElementById('scroll-arrow');
  const hero = document.getElementById('hero');

  if (arrow && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        arrow.style.opacity = entry.isIntersecting ? '1' : '0';
        arrow.style.pointerEvents = entry.isIntersecting ? 'auto' : 'none';
      },
      { threshold: 0.1 }
    );
    observer.observe(hero);
  }
</script>
