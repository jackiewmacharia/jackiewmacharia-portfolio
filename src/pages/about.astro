---
import BaseLayout from '../layouts/BaseLayout.astro';
import { skillLevelVariants } from '../lib/variants';

type SkillLevel = 'Advanced' | 'Intermediate' | 'Beginner';

const experience = [
  {
    role: 'Senior Software Engineer',
    company: 'bettermarks GmbH',
    period: 'May 2024 — Present',
    description: 'Making education better through adaptive learning.',
  },
  {
    role: 'Senior Frontend Engineer',
    company: 'byrd Technologies GmbH',
    period: 'April 2023 — April 2024',
    description:
    'Worked on eCommerce dashboards that handled operations between customers, their end users, partners (warehouses) and internal admin tasks.'
  },
  {
    role: 'Senior Software Engineer',
    company: 'Netlify',
    period: 'March 2022 — December 2022',
    description:
      'Worked on developer tooling at Netlify. Notable projects include the Netlify CLI, Build System and Functions.',
    links: [
      { label: 'Netlify CLI', href: 'https://github.com/netlify/cli' },
      { label: 'Netlify Build', href: 'https://github.com/netlify/build' },
      { label: 'Netlify Functions', href: 'https://docs.netlify.com/build/functions/overview/' },
      { label: 'Edge Functions', href: 'https://www.netlify.com/blog/announcing-serverless-compute-with-edge-functions' },
    ],
  },
  {
    role: 'Software Engineer',
    company: 'Microsoft',
    period: 'Sep 2019 — March 2022',
    description: 'Built Windows Admin Center with the Server Management Experience Team.',
    links: [
      { label: 'Windows Admin Center', href: 'https://www.microsoft.com/en-us/windows-server/windows-admin-center' },
    ],
  },
  {
    role: 'Remote Full Stack Engineer',
    company: 'BuffaloGrid (via Andela)',
    period: 'Nov 2017 — June 2019',
    description: 'Built software for the BuffaloGrid hub and cloud platform.',
  },
  {
    role: 'Remote Frontend Engineer',
    company: 'Famoco (via Andela)',
    period: 'Aug 2017 — Oct 2017',
    description: 'Built and maintained the Famoco Mobile Device Management (MDM) platform.',
  },
  {
    role: 'Software Engineer',
    company: 'Andela',
    period: 'Dec 2016 — Sep 2019',
    description:
      'Worked on internal products and was placed as a remote engineer for Andela clients: Famoco and BuffaloGrid.',
  },
  {
    role: 'Multiple capacities',
    company: 'Waridi Events Ltd, Family Bank Ltd and Ripplez ENT/Mambo Mziki',
    period: '2013 - 2016',
    description: 'Side quested for a minute before learning how to code and becoming a software engineer.',
  }
];

const education = [
  {
    degree: 'Bachelor of Commerce (Finance)',
    institution: 'Jomo Kenyatta University of Agriculture and Technology',
    period: '2009 — 2012',
  },
];

const skills: { name: string; level: SkillLevel }[] = [
  { name: 'JavaScript & TypeScript', level: 'Advanced' },
  { name: 'React & Angular', level: 'Advanced' },
  { name: 'Node.js', level: 'Advanced' },
  { name: 'HTML & CSS', level: 'Advanced' },
  { name: 'Python', level: 'Advanced' },
  { name: 'Django/FastAPI', level: 'Advanced' },
  { name: 'Ruby', level: 'Intermediate' },
  { name: 'Go', level: 'Intermediate' },
];
---

<BaseLayout
  title="About | Jackie Macharia"
  description="Software Engineer with experience at Microsoft, Netlify, and bettermarks. Background in developer tooling, web platforms, and adaptive learning."
>
  <main class="mx-auto max-w-5xl px-6 py-16" data-pagefind-body>
    <header class="mb-16">
      <p class="mb-3 text-sm font-mono text-primary">about me</p>
      <h1 class="mb-6 text-4xl font-bold tracking-tight text-foreground">Jackie Macharia</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Software Engineer with a passion for building great user experiences.
      </p>
    </header>

    <!-- Experience -->
    <section class="mb-20">
      <h2 class="mb-8 text-xs font-mono uppercase tracking-widest text-muted-foreground">Experience</h2>
      <ol>
        {experience.map(({ role, company, period, description, links }) => (
          <li class="group/item flex gap-6">
            <div class="flex shrink-0 flex-col items-center">
              <div class="h-3 w-px bg-border group-first/item:opacity-0"></div>
              <span class="h-3 w-3 shrink-0 rounded-full border-2 border-primary bg-background"></span>
              <div class="w-px flex-1 bg-border group-last/item:opacity-0"></div>
            </div>
            <div class="w-full pb-10">
              <p class="mb-1 text-xs font-mono text-muted-foreground">{period}</p>
              <h3 class="text-base font-semibold text-foreground">
                {role} <span class="text-primary">@ {company}</span>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
              {links && links.length > 0 && (
                <ul class="mt-2 flex flex-wrap gap-3">
                  {links.map(link => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-mono text-primary/80 transition-colors hover:text-primary"
                      >
                        {link.label} &rarr;
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Education -->
    <section class="mb-20">
      <h2 class="mb-8 text-xs font-mono uppercase tracking-widest text-muted-foreground">Education</h2>
      <ol>
        {education.map(({ degree, institution, period }) => (
          <li class="group/item flex gap-6">
            <div class="flex shrink-0 flex-col items-center">
              <div class="h-3 w-px bg-border group-first/item:opacity-0"></div>
              <span class="h-3 w-3 shrink-0 rounded-full border-2 border-border bg-background"></span>
              <div class="w-px flex-1 bg-border group-last/item:opacity-0"></div>
            </div>
            <div class="w-full pb-10">
              <p class="mb-1 text-xs font-mono text-muted-foreground">{period}</p>
              <h3 class="text-base font-semibold text-foreground">{degree}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{institution}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section>
      <h2 class="mb-8 text-xs font-mono uppercase tracking-widest text-muted-foreground">Skills</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {skills.map(({ name, level }) => (
          <li class="flex items-center justify-between rounded border border-border bg-surface px-4 py-3">
            <span class="text-sm font-mono text-foreground">{name}</span>
            <span class={skillLevelVariants({ level })}>
              {level}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
